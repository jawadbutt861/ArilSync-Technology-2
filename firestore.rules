rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn();
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Public site content: Read allowed for all, write strictly restricted to authenticated admins
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(serviceId);
    }

    match /portfolio/{projectId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(projectId);
    }

    match /pricing/{planId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(planId);
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(testimonialId);
    }

    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(settingsId);
    }

    // Inquiries: Anyone can submit a lead inquiry with sanitized fields, only Admins can read or triage
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId)
        && request.resource.data.keys().hasAll(['name', 'email', 'message'])
        && isValidString(request.resource.data.name, 1, 100)
        && isValidString(request.resource.data.email, 3, 120)
        && isValidString(request.resource.data.message, 5, 2000);
      allow read, update, delete: if isAdmin();
    }
  }
}
